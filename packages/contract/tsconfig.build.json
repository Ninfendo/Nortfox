{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // The address check reads a domain as nodemailer does, with node:url.
    "types": ["node"],
    // Read the engine's built types, not its source, so the build emits only
    // this package's own files. Turbo builds the engine first.
    "customConditions": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
