{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "noUpdateNotifier": true,
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
